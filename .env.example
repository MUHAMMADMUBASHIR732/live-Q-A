# ---------------------------------------------------------------
# Copy this file to `.env` and fill it in. Next.js and Prisma both read `.env`.
# ---------------------------------------------------------------

# REQUIRED: PostgreSQL (free at neon.tech).
# Neon gives two strings: pooled (host contains "-pooler") and direct.
# With a local Postgres, use the same string for both.
DATABASE_URL=
DIRECT_URL=

# OPTIONAL: public address used for the QR code and join link.
# Leave empty and the board uses the address open in the presenter's browser.
# For phone testing, open the presenter page at your computer's local IP,
# e.g. http://192.168.1.20:3000/create, so the QR code works on phones.
NEXT_PUBLIC_APP_URL=
# Allow your phone to load the dev site (your computer's local IP).
DEV_ORIGINS=

# OPTIONAL: real-time updates (free at pusher.com, create a Channels app).
# Leave empty and the app polls every 3 seconds instead.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# OPTIONAL: shared rate limiting (free at upstash.com, create a Redis database).
# Leave empty and the app uses an in-memory limiter, which is fine for one server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPTIONAL: real AI. Leave AI_MODE=mock for the free built-in fake AI.
# To use a real model: remove AI_MODE (or change it) and set ANTHROPIC_API_KEY.
AI_MODE=mock
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# MAX_AI_QUESTIONS_PER_SESSION=300
